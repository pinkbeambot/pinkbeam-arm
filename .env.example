# =============================================================================
# PINK BEAM ARM - Environment Configuration
# =============================================================================

# Copy this file to .env.local for local development
# Never commit .env files with real secrets to git

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================

# Supabase project URL
# Get from: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (client-side, RLS-enforced)
# Get from: Supabase Dashboard → Settings → API → Project API Keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (server-side only, bypasses RLS)
# Get from: Supabase Dashboard → Settings → API → Project API Keys → service_role secret
# ⚠️ NEVER expose this to client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase project reference (for CLI commands)
SUPABASE_PROJECT_REF=your-project-ref

# =============================================================================
# APPLICATION CONFIGURATION (Required)
# =============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# STRIPE CONFIGURATION (Required for billing)
# Get from: https://dashboard.stripe.com
# =============================================================================

# Stripe secret key (use test keys for development)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe webhook secret (for webhook verification)
# Get from: Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs (optional - defaults will be used if not set)
# Create these in your Stripe Dashboard under Products
# STRIPE_PRICE_STARTER=price_starter_test
# STRIPE_PRICE_PRO=price_pro_test
# STRIPE_PRICE_BUSINESS=price_business_test
# STRIPE_PRICE_SCALE=price_scale_test

# =============================================================================
# EMAIL CONFIGURATION (Required)
# Get from: https://resend.com
# =============================================================================

# Resend API key for transactional emails
RESEND_API_KEY=re_your-resend-api-key

# =============================================================================
# MONITORING & ERROR TRACKING (Required for production)
# Get from: https://sentry.io
# =============================================================================

# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry auth token for source maps upload (build-time only)
SENTRY_AUTH_TOKEN=sntrys_your-sentry-auth-token

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NEW_FEATURES=false

# =============================================================================
# DEVELOPMENT ONLY (NEVER use in production)
# =============================================================================

# Dev Auth Bypass - DANGEROUS, DEVELOPMENT ONLY
# Set to "true" to skip real authentication during local development
# NEVER enable in production - the build will fail if this is set in production
# This variable is intentionally NOT prefixed with NEXT_PUBLIC_ for security
# DEV_AUTH_BYPASS=true

# =============================================================================
# CI/CD & DEPLOYMENT (GitHub Actions / Vercel)
# These are set as secrets in GitHub and Vercel dashboards, not in .env files
# =============================================================================

# VERCEL_TOKEN=         # Vercel API token
# VERCEL_ORG_ID=        # Vercel organization ID
# VERCEL_PROJECT_ID=    # Vercel project ID
# SUPABASE_ACCESS_TOKEN=# Supabase CLI access token
# SLACK_WEBHOOK_URL=    # Slack webhook for notifications
# SLACK_ALERTS_WEBHOOK_URL=  # Slack webhook for alerts
# SLACK_DEPLOY_WEBHOOK_URL=  # Slack webhook for deployment notifications
