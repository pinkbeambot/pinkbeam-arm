# Supabase Configuration
# Get these values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Configuration
# Get these from your Stripe Dashboard (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs (optional - will use defaults if not set)
# Create these in your Stripe Dashboard under Products
# STRIPE_PRICE_STARTER=price_starter_test
# STRIPE_PRICE_PRO=price_pro_test
# STRIPE_PRICE_BUSINESS=price_business_test
# STRIPE_PRICE_SCALE=price_scale_test

# Dev Auth Bypass - DANGEROUS, DEVELOPMENT ONLY
# Set to "true" to skip real authentication during local development
# NEVER enable in production - the build will fail if this is set in production
# This variable is intentionally NOT prefixed with NEXT_PUBLIC_ for security
# DEV_AUTH_BYPASS=true
