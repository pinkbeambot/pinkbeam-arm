{
  "name": "arm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=e2e-chromium",
    "test:e2e:ui": "playwright test --ui --project=e2e-chromium",
    "test:e2e:headed": "playwright test --headed --project=e2e-chromium",
    "test:visual": "playwright test --project=visual-chromium",
    "test:visual:update": "playwright test --project=visual-chromium --update-snapshots",
    "test:smoke": "./scripts/smoke-test.sh",
    "test:smoke:prod": "./scripts/smoke-test.sh https://pinkbeam.io",
    "predeploy": "./scripts/pre-deploy-check.sh",
    "lighthouse": "lhci autorun",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "analyze": "ANALYZE=true next build",
    "sentry:sourcemaps": "sentry-cli sourcemaps upload --org=pinkbeam --project=arm-production .next/",
    "db:migrate": "supabase db push",
    "db:status": "supabase migration list",
    "backup:create": "./scripts/backup-database.sh",
    "rollback": "./scripts/emergency-rollback.sh"
  },
